#!/usr/bin/env python3
"""hub: the command line of Session Hub (Mantra). Python 3, no pip packages.

  hub register [--name N] [--kind K] [--sid S]   register this session (name and sid are found by themselves)
  hub who                                        every session: live/offline, machine, kind, last message
  hub send <to> "text"                           <to> = a name, its base name before " (", or all
  hub inbox [--since N]                          messages not yet delivered (or after seq N)
  hub watch                                      prints each new message as one line (arm it in a Monitor)
  hub beat                                       one heartbeat (watch beats by itself)

The hub is http://127.0.0.1:8890 on the Mac, http://100.79.251.19:8890 over Tailscale (HUB_URL overrides).
From a cloud session set ALL_PROXY=socks5h://localhost:1055: the connection goes through that SOCKS proxy.
"""
import json, os, re, socket, struct, subprocess, sys, time, uuid
from urllib.parse import urlparse, quote

HOME = os.path.expanduser("~")
STATE = os.path.join(HOME, ".hub")
OTHER = os.path.join(HOME, "Developer/claude-code/tools/other_sessions.py")
BASES = ["http://127.0.0.1:8890", "http://100.79.251.19:8890"]


def bases():
    if os.environ.get("HUB_URL"):
        return [os.environ["HUB_URL"].rstrip("/")]
    try:
        u = open(os.path.join(STATE, "url")).read().strip()
        if u:
            return [u] + BASES
    except Exception:
        pass
    return BASES


def recv_exact(s, n):
    b = b""
    while len(b) < n:
        c = s.recv(n - len(b))
        if not c:
            raise OSError("proxy closed")
        b += c
    return b


def connect(host, port, timeout):
    proxy = os.environ.get("ALL_PROXY") or os.environ.get("all_proxy") or ""
    if proxy.startswith("socks5") and host not in ("127.0.0.1", "localhost"):
        pu = urlparse(proxy)
        s = socket.create_connection((pu.hostname, pu.port or 1080), timeout)
        s.sendall(b"\x05\x01\x00")
        if recv_exact(s, 2)[1] != 0:
            raise OSError("socks auth refused")
        h = host.encode()
        s.sendall(b"\x05\x01\x00\x03" + bytes([len(h)]) + h + struct.pack(">H", port))
        r = recv_exact(s, 4)
        if r[1] != 0:
            raise OSError("socks connect failed (%d)" % r[1])
        if r[3] == 1:
            recv_exact(s, 6)
        elif r[3] == 4:
            recv_exact(s, 18)
        else:
            recv_exact(s, recv_exact(s, 1)[0] + 2)
        return s
    return socket.create_connection((host, port), timeout)


def open_req(base, method, path, body, timeout):
    u = urlparse(base)
    s = connect(u.hostname, u.port or 80, timeout)
    data = json.dumps(body).encode() if body is not None else b""
    head = "%s %s HTTP/1.1\r\nHost: %s\r\nContent-Type: application/json\r\nContent-Length: %d\r\nConnection: close\r\n\r\n" % (
        method, path, u.netloc, len(data))
    s.sendall(head.encode() + data)
    return s


def call(method, path, body=None, timeout=10):
    last = None
    for b in bases():
        try:
            s = open_req(b, method, path, body, timeout)
            raw = b""
            while True:
                c = s.recv(65536)
                if not c:
                    break
                raw += c
            s.close()
            head, _, rest = raw.partition(b"\r\n\r\n")
            code = int(head.split(b" ", 2)[1])
            try:
                return code, json.loads(rest or b"{}")
            except Exception:
                return code, {"raw": rest.decode("utf-8", "replace")}
        except Exception as e:
            last = e
    sys.exit("hub: cannot reach Session Hub (%s). Is the app running and Tailscale up?" % last)


def tailscale_host():
    for exe in ("/usr/local/bin/tailscale", "/Applications/Tailscale.app/Contents/MacOS/Tailscale", "tailscale"):
        try:
            out = subprocess.run([exe, "status", "--self", "--json"], capture_output=True, text=True, timeout=5).stdout
            return json.loads(out)["Self"]["HostName"]
        except Exception:
            continue
    return ""


def identity(args):
    """name, sid, machine, kind, cwd of this session."""
    sid = arg(args, "--sid") or os.environ.get("CLAUDE_SESSION_ID", "")
    name = arg(args, "--name") or os.environ.get("HUB_NAME", "")
    kind = arg(args, "--kind")
    mac_name = ""
    if os.path.exists(OTHER):
        try:
            import importlib.util
            sp = importlib.util.spec_from_file_location("other_sessions", OTHER)
            m = importlib.util.module_from_spec(sp)
            sp.loader.exec_module(m)
            osid = sid or m.own_sid()
            if osid:
                for s in m.sessions():
                    if s["sid"] == osid:
                        mac_name = s["name"]
                sid = sid or osid
                kind = kind or "mac-cli"
        except Exception:
            pass
    os.makedirs(STATE, exist_ok=True)
    saved = os.path.join(STATE, "self.json")
    if not sid:
        try:
            sid = json.load(open(saved)).get("sid", "")
        except Exception:
            pass
    if not sid:
        sid = "s-" + uuid.uuid4().hex[:12]
    cwd = os.getcwd()
    name = name or mac_name or ("%s-%s" % (tailscale_host() or socket.gethostname(), os.path.basename(cwd)))
    machine = tailscale_host() or socket.gethostname().split(".")[0]
    if not kind:
        kind = "cloud" if (os.environ.get("CLAUDE_CODE_REMOTE") or sys.platform.startswith("linux")) else "cli"
    return {"name": name, "sid": sid, "machine": machine, "kind": kind, "cwd": cwd}


def arg(args, flag):
    if flag in args:
        i = args.index(flag)
        if i + 1 < len(args):
            return args[i + 1]
    return ""


def me(args=()):
    me_ = identity(list(args))
    return me_


def register(me_):
    code, j = call("POST", "/register", me_)
    if code != 200:
        sys.exit("hub: register failed: %s" % j)
    json.dump(me_, open(os.path.join(STATE, "self.json"), "w"))
    return j


def fmt(m):
    t = time.strftime("%H:%M", time.localtime(m.get("ts", time.time())))
    return "[hub %s] %s: %s" % (t, m.get("fromName") or m.get("from"), m.get("text", "").replace("\n", " "))


def main():
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help", "help"):
        print(__doc__); return
    cmd, rest = a[0], a[1:]
    if cmd == "register":
        i = me(rest); j = register(i)
        print("registered %s (%s) on %s as %s; %d queued" % (i["name"], i["kind"], i["machine"], i["sid"], j.get("queued", 0)))
    elif cmd == "who":
        code, j = call("GET", "/who")
        for s in j.get("sessions", []):
            ago = ""
            if s["lastMsgAt"]:
                ago = "  last %s: %s" % (time.strftime("%H:%M", time.localtime(s["lastMsgAt"])), s["lastMsg"][:60])
            print("%-7s %-18s %-30s %-8s%s" % ("live" if s["live"] else "offline", s["machine"], s["name"], s["kind"], ago))
    elif cmd == "send":
        if len(rest) < 2:
            sys.exit('usage: hub send <to> "text"')
        i = me()
        if not os.path.exists(os.path.join(STATE, "self.json")):
            register(i)
        code, j = call("POST", "/send", {"from": i["sid"], "to": rest[0], "text": " ".join(rest[1:]), "id": uuid.uuid4().hex})
        if code == 404 and "unknown" in json.dumps(j):
            register(i)
            code, j = call("POST", "/send", {"from": i["sid"], "to": rest[0], "text": " ".join(rest[1:]), "id": uuid.uuid4().hex})
        if code != 200:
            sys.exit("hub: %s" % j.get("error", j))
        for r in j["results"]:
            print("%s: %s" % (r["to"], r["status"]))
    elif cmd == "inbox":
        i = me()
        qs = "/inbox?sid=%s" % quote(i["sid"])
        if arg(rest, "--since"):
            qs += "&since=" + arg(rest, "--since")
        code, j = call("GET", qs)
        if code == 404:
            register(i); code, j = call("GET", qs)
        for m in j.get("messages", []):
            print(fmt(m))
    elif cmd == "beat":
        code, j = call("POST", "/beat", {"sid": me()["sid"]})
        print(j)
    elif cmd == "watch":
        watch(me(rest))
    else:
        sys.exit("unknown command; hub help")


def watch(i):
    register(i)
    while True:
        try:
            for b in bases():
                try:
                    s = open_req(b, "GET", "/watch?sid=" + quote(i["sid"]), None, 10)
                    break
                except Exception:
                    s = None
            if s is None:
                raise OSError("hub unreachable")
            s.settimeout(None)
            f = s.makefile("rb")
            line = f.readline()
            if b" 200" not in line:
                raise OSError("watch refused")
            while f.readline().strip():
                pass
            got = False
            for raw in f:
                got = True
                raw = raw.decode("utf-8", "replace").strip()
                if raw.startswith("data:"):
                    try:
                        print(fmt(json.loads(raw[5:])), flush=True)
                    except Exception:
                        pass
            if not got:
                register(i)
        except SystemExit:
            pass
        except Exception:
            pass
        time.sleep(3)
        try:
            register(i)
        except SystemExit:
            pass


if __name__ == "__main__":
    main()
